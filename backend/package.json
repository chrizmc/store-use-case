{
  "name": "bopis-backend",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p .",
    "start": "node dist/index.js",
    "db:reset": "scripts/with-env.sh 'dropdb --if-exists \"$PGDATABASE\" && createdb \"$PGDATABASE\"'",
    "migrate": "scripts/with-env.sh 'psql -f ../db/schema.sql'",
    "seed": "scripts/with-env.sh 'psql -f ../db/seed_mock_sap.sql && psql -f ../db/seed_rules.sql'",
    "seed:demo-order": "scripts/with-env.sh 'psql -f ../db/seed_demo_order.sql'",
    "neo4j:reset": "scripts/with-env.sh 'cypher-shell -u \"$NEO4J_USER\" -p \"$NEO4J_PASSWORD\" \"MATCH (n) DETACH DELETE n\"'",
    "neo4j:init": "scripts/with-env.sh 'cypher-shell -u \"$NEO4J_USER\" -p \"$NEO4J_PASSWORD\" -f ../neo4j/constraints.cypher'",
    "seed:neo4j": "tsx scripts/seedNeo4j.ts",
    "seed:embeddings": "tsx scripts/backfillEmbeddings.ts",
    "demo:reset": "npm run db:reset && npm run migrate && npm run seed && npm run seed:embeddings && npm run neo4j:reset && npm run neo4j:init && npm run seed:neo4j"
  },
  "dependencies": {
    "@fastify/multipart": "^8.3.1",
    "@fastify/static": "^6.12.0",
    "dotenv": "^16.4.5",
    "fastify": "^4.28.1",
    "neo4j-driver": "^5.24.0",
    "pg": "^8.12.0"
  },
  "devDependencies": {
    "@types/node": "^22.5.0",
    "@types/pg": "^8.11.6",
    "tsx": "^4.16.5",
    "typescript": "^5.5.4"
  }
}
