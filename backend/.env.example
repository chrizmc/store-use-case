PGHOST=localhost
PGPORT=5432
# Homebrew Postgres uses trust auth for your OS user by default: PGUSER=$(whoami), PGPASSWORD empty.
PGUSER=postgres
PGPASSWORD=postgres
PGDATABASE=bopis

NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=password

PORT=3000

# Piper TTS was installed via pip (Homebrew formula unreliable); point at the system python3
# where `pip install piper-tts` was run, and the downloaded .onnx voice model.
PIPER_PYTHON=/usr/bin/python3
PIPER_MODEL_PATH=models/en_US-lessac-medium.onnx

# whisper.cpp does not bundle a model; ggml-base.en.bin was downloaded separately.
WHISPER_MODEL_PATH=models/whisper/ggml-base.en.bin
